# Copy this file to .env and fill in real values. .env is gitignored — never commit real credentials.

# From Facebook Page > Settings > About, or the Graph API /me/accounts response.
FB_PAGE_ID=

# Long-lived Page Access Token from the /me/accounts exchange (see decision 0002).
FB_PAGE_ACCESS_TOKEN=

# From your LinkedIn Developer App's Auth tab (linkedin.com/developers/apps).
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Filled in automatically by src/linkedin_auth.py — do not set by hand.
LINKEDIN_ACCESS_TOKEN=

# Fine-grained GitHub PAT, scoped to this repo only, with "Secrets: Read and
# write" permission — used only by tools/set_github_secrets.py, never
# committed. Delete/revoke it once secrets are set if you don't need it again.
GITHUB_PAT=
